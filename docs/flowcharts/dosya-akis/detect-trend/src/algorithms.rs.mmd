graph TD
    A([Başlangıç: sma_ema_crossover]) --> B{klines.len() < 21?}
    B -- Evet --> B1([Bitiş: NEUTRAL TrendResult])
    B -- Hayır --> C[calculate_ema(9) -> ema_fast, calculate_ema(21) -> ema_slow]
    C --> D{ema_fast > ema_slow?}
    D -- Evet --> D1[trend = BULL]
    D1 --> E
    D -- Hayır --> D2[trend = BEAR]
    D2 --> E
    E --> F[diff = (fast-slow)/slow * 100 hesaplanır]
    F --> G([Bitiş: TrendResult döner])

    H([Başlangıç: linear_regression]) --> I[n = min(len, 50)]
    I --> J{n < 2?}
    J -- Evet --> J1([Bitiş: NEUTRAL TrendResult])
    J -- Hayır --> K[son n mum için sum_x, sum_y, sum_xy, sum_xx toplanır]
    K --> L[slope = OLS formülüyle hesaplanır]
    L --> M[normalized_slope = slope/last_price*100]
    M --> N{slope > %0.05 mi?}
    N -- Evet --> N1[trend = BULL]
    N1 --> O
    N -- Hayır --> N2{slope < -%0.05 mi?}
    N2 -- Evet --> N3[trend = BEAR]
    N3 --> O
    N2 -- Hayır --> N4[trend = NEUTRAL]
    N4 --> O
    O --> P([Bitiş: TrendResult döner])

    Q([Başlangıç: adx]) --> R{klines.len() < 15?}
    R -- Evet --> R1([Bitiş: NEUTRAL TrendResult])
    R -- Hayır --> S[son 15 mum için TR, +DM, -DM toplanır]
    S --> T[pdi, ndi hesaplanır]
    T --> U[dx = |pdi-ndi|/(pdi+ndi)*100]
    U --> V{dx > 25?}
    V -- Evet --> V1{pdi > ndi?}
    V1 -- Evet --> V2[trend = BULL]
    V1 -- Hayır --> V3[trend = BEAR]
    V2 --> W
    V3 --> W
    V -- Hayır --> V4[trend = NEUTRAL]
    V4 --> W
    W --> X([Bitiş: TrendResult döner])

    Y([Başlangıç: supertrend]) --> Z{klines.len() < 10?}
    Z -- Evet --> Z1([Bitiş: NEUTRAL TrendResult])
    Z -- Hayır --> Z2[calculate_atr(10) hesaplanır]
    Z2 --> Z3[hl2, upper_band, lower_band hesaplanır]
    Z3 --> Z4{last.close > hl2?}
    Z4 -- Evet --> Z5[trend = BULL]
    Z4 -- Hayır --> Z6[trend = BEAR]
    Z5 --> Z7
    Z6 --> Z7
    Z7 --> Z8([Bitiş: TrendResult döner])

    AA([Başlangıç: dow_theory]) --> AB{klines.len() < 10?}
    AB -- Evet --> AB1([Bitiş: NEUTRAL TrendResult])
    AB -- Hayır --> AC[2 mum geri/düz ileri: yüksek ve düşükler toplanır]
    AC --> AD{highs>=2 ve lows>=2?}
    AD -- Evet --> AE{son HH ve HL yükseliyor mu?}
    AE -- Evet --> AE1[trend = BULL]
    AE -- Hayır --> AE2{son HH ve HL düşüyor mu?}
    AE2 -- Evet --> AE3[trend = BEAR]
    AE2 -- Hayır --> AE4[trend = NEUTRAL]
    AE1 --> AF
    AE3 --> AF
    AE4 --> AF
    AD -- Hayır --> AD1[trend = NEUTRAL]
    AD1 --> AF
    AF --> AG([Bitiş: TrendResult döner])

    AH([Başlangıç: hurst_exponent]) --> AI{klines.len() < 100?}
    AI -- Evet --> AI1([Bitiş: NEUTRAL TrendResult])
    AI -- Hayır --> AJ[log getirileri hesaplanır]
    AJ --> AK[mean, max/min, varyans ve std_dev hesaplanır]
    AK --> AL[rs = range/std_dev, hurst = ln(rs)/ln(n)]
    AL --> AM[normalized_hurst 0.1-0.9 aralığına sıkıştırılır]
    AM --> AN{normalized_hurst > 0.55?}
    AN -- Evet --> AO{son getiri > 0?}
    AO -- Evet --> AO1[trend = BULL]
    AO -- Hayır --> AO2[trend = BEAR]
    AO1 --> AP
    AO2 --> AP
    AN -- Hayır --> AN1{normalized_hurst < 0.45?}
    AN1 -- Evet --> AN2[trend = NEUTRAL (CHOP)]
    AN2 --> AP
    AN1 -- Hayır --> AN3[trend = NEUTRAL]
    AN3 --> AP
    AP --> AQ([Bitiş: TrendResult döner])

    AR([Başlangıç: hmm_simplified]) --> AS{klines.len() < 20?}
    AS -- Evet --> AS1([Bitiş: NEUTRAL TrendResult])
    AS -- Hayır --> AT[calculate_atr(14), momentum ve vol_ratio hesaplanır]
    AT --> AU{vol_ratio > %2?}
    AU -- Evet --> AU1[trend = NEUTRAL (CHAOS), rejim=2]
    AU1 --> AV
    AU -- Hayır --> AU2{momentum > %0.1?}
    AU2 -- Evet --> AU3[trend = BULL (TRENDING), rejim=0]
    AU3 --> AV
    AU2 -- Hayır --> AU4{momentum < -%0.1?}
    AU4 -- Evet --> AU5[trend = BEAR (TRENDING), rejim=1]
    AU5 --> AV
    AU4 -- Hayır --> AU6[trend = NEUTRAL, rejim=2]
    AU6 --> AV
    AV --> AW([Bitiş: TrendResult döner])

    AX([Başlangıç: fourier_trend]) --> AY[n = min(len, 64)]
    AY --> AZ{n < 64?}
    AZ -- Evet --> AZ1([Bitiş: NEUTRAL TrendResult])
    AZ -- Hayır --> AZ2[DFT: son n mum için real/imag kısımlar hesaplanır]
    AZ2 --> AZ3[magnitude ve faz (atan2) hesaplanır]
    AZ3 --> AZ4[slope = cos(güncel açı)]
    AZ4 --> AZ5{slope > 0.1?}
    AZ5 -- Evet --> AZ6[trend = BULL]
    AZ5 -- Hayır --> AZ7{slope < -0.1?}
    AZ7 -- Evet --> AZ8[trend = BEAR]
    AZ7 -- Hayır --> AZ9[trend = NEUTRAL]
    AZ6 --> AZ10
    AZ8 --> AZ10
    AZ9 --> AZ10
    AZ10 --> AZ11([Bitiş: TrendResult döner])

    BA([Başlangıç: parabolic_sar]) --> BB{klines.len() < 5?}
    BB -- Evet --> BB1([Bitiş: NEUTRAL TrendResult])
    BB -- Hayır --> BC[son 5 mumun açılış-kapanış karşılaştırması yapılır]
    BC --> BD{son close > ilk close?}
    BD -- Evet --> BD1[trend = BULL]
    BD -- Hayır --> BD2[trend = BEAR]
    BD1 --> BE
    BD2 --> BE
    BE --> BF([Bitiş: TrendResult döner])

    BG([Başlangıç: ichimoku]) --> BH{klines.len() < 52?}
    BH -- Evet --> BH1([Bitiş: NEUTRAL TrendResult])
    BH -- Hayır --> BI[tenkan_sen(9), kijun_sen(26), senkou_span_b(52) hesaplanır]
    BI --> BJ[senkou_span_a = (tenkan+kijun)/2]
    BJ --> BK[top_cloud ve bot_cloud hesaplanır]
    BK --> BL{last.close > top_cloud?}
    BL -- Evet --> BL1[trend = BULL]
    BL -- Hayır --> BL2{last.close < bot_cloud?}
    BL2 -- Evet --> BL3[trend = BEAR]
    BL2 -- Hayır --> BL4[trend = NEUTRAL (INSIDE CLOUD)]
    BL1 --> BM
    BL3 --> BM
    BL4 --> BM
    BM --> BN([Bitiş: TrendResult döner])
