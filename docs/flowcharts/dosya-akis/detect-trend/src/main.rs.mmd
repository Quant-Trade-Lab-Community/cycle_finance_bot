graph TD
    A([Başlangıç: main]) --> B[Başlık yazdırılır: QUANT TREND & REJİM ANALİZ MOTORU]
    B --> C[AppState oluşturulur: BinanceClient::new]

    C --> D[Router kurulur: /api/trend -> get_trends]
    D --> E[SocketAddr: 127.0.0.1:3001]
    E --> F[API sunucusu dinleniyor ve örnek kullanım mesajı yazdırılır]
    F --> G[TCP listener 3001 portuna bağlanır]
    G --> H[axum::serve ile sunucu çalışır]

    H --> I([HTTP isteği: GET /api/trend geldiğinde])
    I --> J[Query'den params okunur: symbol, interval, limit]
    J --> K[limit = params.limit.unwrap_or(500)]
    K --> L[fetch_klines(symbol, interval, limit) çağrılır]
    L --> M{Veri çekme başarılı mı?}

    M -- Hayır --> M1[error JSON döner]
    M1 --> Z
    M -- Evet --> N{klines boş mu?}
    N -- Evet --> N1["error: No data received" JSON döner]
    N1 --> Z
    N -- Hayır --> O[current_price = son mumun close değeri]

    O --> P[10 trend algoritması sırayla çalıştırılır]
    P --> P1[1. sma_ema_crossover]
    P1 --> P2[2. linear_regression]
    P2 --> P3[3. adx]
    P3 --> P4[4. supertrend]
    P4 --> P5[5. dow_theory]
    P5 --> P6[6. hurst_exponent]
    P6 --> P7[7. hmm_simplified]
    P7 --> P8[8. fourier_trend]
    P8 --> P9[9. parabolic_sar]
    P9 --> P10[10. ichimoku]

    P10 --> Q[APIResponse oluşturulur: status, symbol, interval, current_price, results]
    Q --> R[JSON yanıtı döner]

    R --> Z([Bitiş])
