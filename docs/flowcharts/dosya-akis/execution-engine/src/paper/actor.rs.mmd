graph TD
    A([Başlangıç]) --> B["PaperEngineActor::new(config)"]
    B --> C["new_with_events(config, event_tx=None, replay_events=[])"]
    C --> D["AccountState::new(initial_usdt, initial_btc)"]
    D --> E["RiskManager::new(...)"]
    E --> F["position_mode = from_str(config.position_mode)"]
    F --> G["default_margin_type = from_str(config.margin_type)"]
    G --> H["Actor state'leri başlat: positions, open_orders, mark_prices, snapshot vb."]
    H --> I{replay_events boş değil mi?}
    I -- Evet --> J["rebuild_from_events(replay_events)"]
    J --> K
    I -- Hayır --> K["publish_snapshot()"]
    K --> L["Actor oluşturuldu"]

    L --> M[run: mailbox loop]
    M --> N{cmd_rx.recv() geldi mi?}

    N -- SubmitOrder --> O["process_order(order).await"]
    O --> P["response_tx.send(result)"]
    P --> Q

    N -- MarkPriceUpdate --> R["mark_prices/funding_rates güncelle"]
    R --> S["on_mark_tick(timestamp)"]
    S --> T["check_limit_orders(symbol, mark_price)"]
    T --> Q

    N -- SetPositionMode --> U["set_position_mode(mode)"]
    U --> V["response_tx.send(res)"]
    V --> Q

    N -- SetMarginType --> W["set_margin_type(symbol, margin_type)"]
    W --> X["response_tx.send(res)"]
    X --> Q

    Q["publish_snapshot()"] --> M

    %% process_order akışı
    O --> P1["Latency simülasyonu: base_latency + jitter, sleep"]
    P1 --> P2["process_price_only(order)"]
    P2 --> P3{mark price > 0?}
    P3 -- Hayır --> P4["Err: MarketUnavailable"]
    P3 -- Evet --> P5{position_mode Hedge?}
    P5 -- Evet + position_side Long --> P6["target_side = Long"]
    P5 -- Evet + position_side Short --> P7["target_side = Short"]
    P5 -- Evet + position_side Both --> P8["Err: RiskRejected (HEDGE'te side zorunlu)"]
    P5 -- Hayır OneWay --> P9["target_side = None"]
    P6 --> P10{order_type?}
    P7 --> P10
    P8 --> P26
    P9 --> P10

    P10 -- Market --> P11["risk.check_order(quantity, leverage, cash)"]
    P11 --> P12{risk kontrolü başarısız?}
    P12 -- Evet --> P13["Err: RiskRejected"]
    P12 -- Hayır --> P14["margin_delta = |before+signed| - |before|"]
    P14 --> P15["emit OrderCreated"]
    P15 --> P16["fee = qty * taker_fee"]
    P16 --> P17{free < margin_locked + fee?}
    P17 -- Evet --> P18["Err: InsufficientFunds"]
    P17 -- Hayır --> P19["lock_margin, release_margin, fee kes"]
    P19 --> P20["apply_fill_dispatch -> pozisyon güncelle"]
    P20 --> P21["risk.record_realized, cash + realized"]
    P21 --> P22["emit_fill + persist_trade"]
    P22 --> P23["Ok(OrderAck{avg=mark})"]

    P10 -- Limit --> P24["risk.check_order"]
    P24 --> P25{başarısız?}
    P25 -- Evet --> P26["Err: RiskRejected"]
    P25 -- Hayır --> P27["margin = qty / leverage"]
    P27 --> P28{free < margin?}
    P28 -- Evet --> P29["Err: InsufficientFunds"]
    P28 -- Hayır --> P30["lock_margin, emit OrderCreated"]
    P30 --> P31{limit fiyat geçildi mi?}
    P31 -- Evet --> P32["fill_limit(...)"]
    P32 --> P33["Ok(OrderAck{avg=limit_price})"]
    P31 -- Hayır --> P34["open_orders.push(OpenOrder)"]
    P34 --> P35["Ok(OrderAck PENDING)"]

    P10 -- Diğer --> P26

    P23 --> P26["process_order sonucu: response_tx'e gönderilir"]

    %% mark tick akışı
    S --> S1["risk.on_mark_tick -> liquidated listesi"]
    S1 --> S2{8 saat funding aralığı geçti mi?}
    S2 -- Evet --> S3["apply_funding(): notional * rate, cash düş, emit FundingRateApplied"]
    S2 -- Hayır --> S4
    S3 --> S4{liquidated boş mu?}
    S4 -- Hayır --> S5[Her likidasyon için döngü]
    S5 --> S6["apply_fill_dispatch ile pozisyonu kapat"]
    S6 --> S7["release_margin, cash + realized"]
    S7 --> S8["emit_fill + emit Liquidation + persist_trade"]
    S8 --> S9{döngüde likidasyon kaldı mı?}
    S9 -- Evet --> S5
    S9 -- Hayır --> S10
    S4 -- Evet --> S10["mark tick tamam"]

    %% limit kontrol akışı
    T --> T1[open_orders üzerinde döngü]
    T1 --> T2{sembol eşleşiyor mu?}
    T2 -- Hayır --> T3
    T2 -- Evet --> T4{fiyat limiti geçti mi?}
    T4 -- Hayır --> T3
    T4 -- Evet --> T5["fill_data ekle, filled indeksi kaydet"]
    T3 --> T6{döngüde emir kaldı mı?}
    T6 -- Evet --> T1
    T6 -- Hayır --> T7["Her fill için fill_limit(...)"]
    T7 --> T8["filled indeksleri ters sırayla kaldır"]
    T8 --> T9["check_limit_orders tamam"]

    %% set_position_mode akışı
    U --> U1{mode aynı mı?}
    U1 -- Evet --> U2["Ok döndür"]
    U1 -- Hayır --> U3{açık pozisyon var mı?}
    U3 -- Evet --> U4["Err: açık pozisyon varken değişmez"]
    U3 -- Hayır --> U5{açık emir var mı?}
    U5 -- Evet --> U6["Err: açık emir varken değişmez"]
    U5 -- Hayır --> U7["position_mode = mode, Ok döndür"]
    U2 --> U8
    U4 --> U8
    U6 --> U8
    U7 --> U8([Bitiş: actor run döngüsü devam])
