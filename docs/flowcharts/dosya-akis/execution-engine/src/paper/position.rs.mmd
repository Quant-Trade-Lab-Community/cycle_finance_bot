graph TD
    A([Başlangıç]) --> B[Position struct: symbol, side, quantity USDT notional, avg_entry_price, leverage]

    B --> C[unrealized_pnl(mark_price)]
    C --> D{side == Long?}
    D -- Evet --> E["(mark - entry) / entry * |qty|"]
    D -- Hayır --> F["(entry - mark) / entry * |qty|"]
    E --> G
    F --> G[notional(mark_price)]
    G --> H["|qty| * mark / entry"]
    H --> I[liquidation_price(maintenance_rate)]
    I --> J{side == Long?}
    J -- Evet --> K["entry * (1 - 1/lev + maintenance)"]
    J -- Hayır --> L["entry * (1 + 1/lev - maintenance)"]
    K --> M
    L --> M[PositionManager::new: positions + hedge_positions hashmap]

    M --> N[apply_fill: ONE_WAY emir bazlı güncelleme]
    N --> O{pozisyon açık? quantity != 0}
    O -- Evet --> P{aynı yön mü?}
    P -- Hayır --> Q["close_qty = min(|fill|, |pos|)"]
    Q --> R["realized PnL hesapla: (fill - entry)/entry * close_qty"]
    R --> S["pos.quantity += fill_qty"]
    S --> T{quantity == 0?}
    T -- Evet --> U["pozisyonu kaldır, (realized, closed) döndür"]
    T -- Hayır --> V{yön değişti mi?}
    V -- Evet --> W["side ters çevir, entry = fill_price, leverage güncelle"]
    V -- Hayır --> X["(realized, closed) döndür"]
    P -- Evet --> Y{quantity == 0?}
    O -- Hayır --> Y
    Y -- Evet --> Z1["Yeni açılış: side = fill yönü, qty = fill, entry = fill_price"]
    Y -- Hayır --> Z2["Büyütme: ağırlıklı ortalama entry = total_notional / toplam_coin"]
    Z1 --> Z3["(realized, closed) döndür"]
    Z2 --> Z3

    W --> Z3
    X --> Z3
    U --> Z([Bitiş: apply_fill])

    M --> A1[apply_fill_hedge: HEDGE taraf güncelleme]
    A1 --> A2{taraf pozisyon açık?}
    A2 -- Evet --> A3{aynı yön mü?}
    A3 -- Hayır --> A4["realized PnL hesapla"]
    A4 --> A5["pos.quantity += fill_qty"]
    A5 --> A6{quantity == 0?}
    A6 -- Evet --> A7["hedge pozisyonu kaldır"]
    A6 -- Hayır --> A8{ters tarafa mı geçiyor?}
    A8 -- Evet --> A9["quantity = 0, pozisyonu kaldır (netleştirme yok)"]
    A8 -- Hayır --> B1["(realized, closed) döndür"]
    A3 -- Evet --> B2{quantity == 0?}
    A2 -- Hayır --> B2
    B2 -- Evet --> B3["Yeni açılış: side = hedef taraf, qty = fill"]
    B2 -- Hayır --> B4["Ağırlıklı ortalama entry hesapla"]
    B3 --> B5["(realized, closed) döndür"]
    B4 --> B5
    A7 --> B5
    A9 --> B5
    B1 --> B5

    B5 --> Z
