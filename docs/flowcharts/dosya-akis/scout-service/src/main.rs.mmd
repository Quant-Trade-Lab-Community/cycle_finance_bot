graph TD
    A([Başlangıç]) --> B[ScoutService::new: client, market, ring oluştur]
    B --> C[service.start(): fetch_symbols çağır]

    C --> D{semboller çekildi mi?}
    D -- Hayır --> E[eprintln + process::exit 1]
    D -- Evet --> F[market = MarketState::new(symbols)]

    F --> G[book ticker görevleri: sembolleri parçala, her parça için stream_book_tickers spawn et]
    G --> H[handler her mesajda handle_book_ticker çağır]

    H --> I[depth_manager_loop spawn et]
    I --> J[analysis_loop spawn et]

    J --> K[ctrl_c sinyali bekle]
    K --> L[service.stop: tüm task'ları abort et]
    L --> Z([Bitiş])

    A --> M[handle_book_ticker: data['s'] çıkar]
    M --> N{symbol var mı?}
    N -- Hayır --> O[dön]
    N -- Evet --> P[bid/ask parse et, state.update_book_ticker]

    A --> Q[depth_manager_loop: sonsuz döngü]
    Q --> R[get_depth_candidates -> candidates]
    R --> S{candidates boş VE depth izleniyor mu?}
    S -- Evet --> T[sleep ANALYSIS_INTERVAL, continue]
    S -- Hayır --> U{rebalance gerekli mi?}
    U -- Hayır --> V[sleep, döngü başına dön]
    U -- Evet --> W[mevcut depth task'ları abort et]
    W --> X[depth_symbols güncelle, last_rebalance = now]
    X --> Y{en az bir aday var mı?}
    Y -- Hayır --> V
    Y -- Evet --> AA[derinlikleri parçala, her parça için stream_partial_depths spawn et]
    AA --> V

    A --> AB[analysis_loop: WINDOW_SECONDS ısınma bekle]
    AB --> AC[sonsuz döngü]
    AC --> AD[get_best_opportunity + get_symbol_metrics]
    AD --> AE{fırsat var mı?}
    AE -- Evet --> AF[logger.log: FIRSAT BULUNDU / FIRSAT DEVAM]
    AE -- Hayır --> AG[ring'e push_symbol_metrics]
    AF --> AG
    AG --> AH[sleep ANALYSIS_INTERVAL, döngü başına dön]

    A --> AI[ScoutRing.push_opportunity: OwnedEvent encode et, ring.push]
