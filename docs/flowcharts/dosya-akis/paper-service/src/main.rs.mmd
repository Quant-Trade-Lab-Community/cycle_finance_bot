graph TD
    A([Başlangıç]) --> B[main: tracing_subscriber init + banner]
    B --> C[config = PaperConfig::load_from_env]
    C --> D[events::open_wal_store: Sled WAL aç]
    D --> E[store.lock + replay -> replay_events]
    E --> F{replay_events boş değil mi?}
    F -- Evet --> G[RECOVERY log: state replay ediliyor]
    G --> H
    F -- Hayır --> H{DATABASE_URL env var mı?}
    H -- Evet --> I{PostgresEventStore::connect başarılı mı?}
    I -- Evet --> J[postgres = Some(PG)]
    I -- Hayır --> K[uyarı: Sled WAL yedekli, postgres = None]
    H -- Hayır --> K

    J --> CH[event_tx/event_rx unbounded kanal oluştur]
    K --> CH
    CH --> C1{sonsuz döngü: tokio::select dalları}
    C1 -- flush_interval.tick --> C2[projection.flush sqlite_conn]
    C2 --> C1
    C1 -- event_rx.recv event geldi --> C3[store.lock + guard.append Sled WAL]
    C3 --> C4{feature full ve postgres Some mı?}
    C4 -- Evet --> C5[pg.append event async]
    C5 --> C6[projection.apply event]
    C4 -- Hayır --> C6
    C6 --> C7{count % 1000 == 0 mı?}
    C7 -- Evet --> C8[WAL log yaz]
    C8 --> C1
    C7 -- Hayır --> C1
    C1 -- else kanal kapandı --> C9[final projection.flush + break]
    C9 --> Z([Bitiş])

    CH --> A1[PaperEngineActor::new_with_events config + event_tx + replay_events]
    A1 --> A2[snapshot = actor.snapshot_handle]
    A2 --> A3[actor.run(cmd_rx) tokio spawn]
    A3 --> AU[auth: PAPER_ADMIN_USER/PASS + Argon2 hash + JWT secret]
    AU --> AP[EngineHandle + Metrics + AppState]
    AP --> API[api::serve tokio spawn: REST dinle]
    API --> BR[bridge::spawn_ring_bridge cmd_tx]
    BR --> SIG[tokio::signal::ctrl_c bekle]
    SIG --> SD[Shutting down log]
