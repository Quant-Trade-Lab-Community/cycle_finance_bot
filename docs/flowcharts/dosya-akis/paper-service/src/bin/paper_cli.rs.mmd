graph TD
    A([Başlangıç]) --> B[main: Cli::parse komut satırı argümanları]
    B --> C[run(cli) çağrısı]
    C --> R[ApiClient oluştur: base = cli.api, reqwest::Client]
    R --> L[client.login: POST /api/v1/auth/login]
    L -- Başarısız --> LE[Giriş başarısız hatası dön]
    L -- Başarılı --> M{komut dallanması cli.command}

    M -- Status --> S[GET /api/v1/account/balance + /api/v1/system/health]
    S --> SW[bakiye, equity, PnL, risk, last_price yazdır]
    M -- Positions --> P[GET /api/v1/account/positions]
    P --> PE{positions dizisi boş mu?}
    PE -- Evet --> PN[[None] yazdır]
    PE -- Hayır --> PL[döngü: her pozisyon için PnL işareti + satır yazdır]
    M -- History --> H[GET /api/v1/account/trade-history]
    H --> HE{trades dizisi boş mu?}
    HE -- Evet --> HN[[None] yazdır]
    HE -- Hayır --> HL[döngü: son 20 işlemi yazdır]
    M -- Liquidation --> Q[GET /api/v1/risk/liquidation-price/symbol]
    Q --> QW[likidasyon fiyatı yazdır]
    M -- Order --> O[body oluştur: client_order_id varsayılan cli_now_ms]
    O --> OP{price verildi mi?}
    OP -- Evet --> OPP[price ekle]
    OP -- Hayır --> OPN[price ekleme]
    OPP --> OR[POST /api/v1/order]
    OPN --> OR
    OR --> OE{yanıtta error alanı var mı?}
    OE -- Evet --> OER[Emir reddedildi yazdır]
    OE -- Hayır --> OOK[Emir gönderildi: order_id, avg, qty yazdır]

    SW --> OK[Ok dön]
    PN --> OK
    PL --> OK
    HN --> OK
    HL --> OK
    QW --> OK
    OER --> OK
    OOK --> OK
    OK --> E{run hatasız mu?}
    LE --> EH[eprintln Hata + process::exit 1]
    E -- Hata --> EH
    E -- Tamam --> Z([Bitiş])
    EH --> Z
