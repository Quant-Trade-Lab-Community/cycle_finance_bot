graph TD
    A([Başlangıç]) --> B[open_connection(db_path): Connection::open]
    B --> C{bağlantı başarılı mı?}
    C -- Evet --> D[PRAGMA journal_mode=WAL + synchronous=NORMAL]
    D --> E[CREATE TABLE paper_trades]
    E --> F[CREATE TABLE paper_open_orders]
    F --> G[SqliteProjection::new: opens + pending_trades]
    C -- Hata --> H[fallback open_connection /dev/null]

    G --> I[apply(event): memory projection]
    I --> J{event türü nedir?}
    J -- OrderCreated --> K[opens.insert order_id -> OpenRow]
    J -- OrderFilled --> L[open_qty -= fill_qty]
    L --> M[pending_trades.push trade kaydı]
    J -- OrderCancelled --> N[open_qty = Decimal::ZERO]
    J -- Diğer --> O[yoksay]
    K --> P[applied += 1]
    M --> P
    N --> P
    O --> P

    P --> Q[flush(conn)]
    Q --> R{pending_trades ve opens boş mu?}
    R -- Evet --> S[direkt Ok dön]
    R -- Hayır --> T[conn.transaction başlat]
    T --> U[paper_trades INSERT için pending_trades drene et]
    U --> V[paper_open_orders INSERT OR REPLACE tam set]
    V --> W[tx.commit tek transaction]
    W --> S
