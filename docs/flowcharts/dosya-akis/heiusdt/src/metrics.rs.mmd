graph TD
    A([Başlangıç: process_tick]) --> B[lee_ready_sign: trade yönünü belirle]
    B --> C{price > mid mi?}
    C -- Evet --> D[sign = +1]
    C -- Hayır --> E{price < mid mi?}
    E -- Evet --> F[sign = -1]
    E -- Hayır --> G{prev_delta sıfır değil mi?}
    G -- Evet --> H[sign = prev_sign]
    G -- Hayır --> I[tick rule: P_t ile P_{t-2} karşılaştır]
    D --> J[prev_prev_price, prev_price, prev_sign durumlarını güncelle]
    F --> J
    H --> J
    I --> J

    J --> K[update_eff_delta: s_eff/s_bar oranıyla eff_delta katkısını ekle]
    K --> L{yeni saniyeye geçildi mi?}
    L -- Evet --> M[eff_delta_hist'e değeri ekle, pencereyi kırp]
    L -- Hayır --> N{eff_delta_hist uzunluğu >= 2 mi?}
    M --> N
    N -- Evet --> O[delta_velocity = son değer - önceki değer]
    O --> P[update_absorption: (qty, sign) ikilisini kuyruğa ekle]
    P --> Q[buy ve sell hacimlerini pencere içinde topla]
    Q --> R[absorption = buy / sell]
    R --> S[update_avpin: Parkinson H/L seviyelerini güncelle]
    S --> T[trade'i bucket listelerine ekle, n_bucket sınırını uygula]
    T --> U[b_vol = alpha_bucket * parkinson * ortalama hacim]
    U --> V[avpin = |buy - sell| / (n * b_vol)]

    V --> W[update_hasbrouck: r ve x dizilerine yeni örnekleri ekle]
    W --> X{örnek sayısı >= 30 mu?}
    X -- Evet --> Y[OLS ile alpha1 ve alpha2 katsayılarını hesapla]
    Y --> A1{denom tekil mi?}
    A1 -- Evet --> B1[kalıcı etki hesabını atla]
    A1 -- Hayır --> C1[permanent_impact ve temporary_impact hesapla]
    B1 --> D1[update_efp: qty / toplam derinlik]
    C1 --> D1
    X -- Hayır --> D1

    D1 --> E1[update_tps: pencere içindeki trade sayısını hesapla]
    E1 --> F1[refresh: tüm metrikleri tazele]
    F1 --> G1[compute_wlobi: üstel ağırlıklı LOB dengesini hesapla]
    G1 --> H1[compute_slopes: ask ve bid eğimlerini hesapla]
    H1 --> I1[compute_signal: Z-skorlarıyla alpha basket hesapla]
    I1 --> J1{aVPIN >= 0.6 mı?}
    J1 -- Evet --> K1[signal = 0 toksik akış]
    J1 -- Hayır --> L1{p_long > 0.65 mi?}
    L1 -- Evet --> M1[signal = +1 LONG]
    L1 -- Hayır --> N1{p_long < 0.35 mi?}
    N1 -- Evet --> O1[signal = -1 SHORT]
    N1 -- Hayır --> P1[signal = 0 Nötr]
    K1 --> Q1[signal döndür]
    M1 --> Q1
    O1 --> Q1
    P1 --> Q1
    Q1 --> Z([Bitiş])
