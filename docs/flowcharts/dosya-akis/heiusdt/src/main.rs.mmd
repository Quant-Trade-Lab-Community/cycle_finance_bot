graph TD
    A([Başlangıç]) --> B[load_config: env değişkenleri ve CLI argümanlarından config oku]
    B --> C[reqwest Client oluştur, 30 sn timeout]
    C --> D{cfg.once?}

    D -- Evet --> E[analyze_once ile tek değerlendirme yap]
    E --> F[zaman damgasıyla sonucu konsola yaz]
    F --> Z([Bitiş])

    D -- Hayır --> G[mpsc unbounded kanal oluştur]
    G --> H[spawn_price_reader: ring okuyucu thread başlat]

    H --> I[thread döngüsü: gen_ring.read_slot(cursor)]
    I --> J{slot var mı?}
    J -- Evet --> K[wire::decode ile event'i çöz]
    K --> L{event çözüldü mü?}
    L -- Evet --> L2{sembol eşleşiyor mu?}
    L2 -- Evet --> M[event_price ile fiyatı çıkar]
    L2 -- Hayır --> N[cursor += 1]
    M --> N2{tx.send başarılı mı?}
    N2 -- Evet --> N[cursor += 1]
    N2 -- Hayır --> P[thread sonlanır]
    N --> I
    L -- Hayır --> N
    J -- Hayır --> Q[head > cursor ise arayı kapat, değilse 500us uyu]
    Q --> I

    H --> S[ana döngü: timeout 500ms ile rx.recv bekle]
    S --> T{kanaldan fiyat geldi mi?}
    T -- Evet --> U[latest_price = gelen fiyat]
    T -- Hayır --> V[current_wait_sec ile bekleme süresini oku]
    U --> V
    V --> W{startup veya bekleme süresi doldu mu?}
    W -- Hayır --> S
    W -- Evet --> X[analyze_once: güncel fiyatla kırılım değerlendir]
    X --> Y[sonucu konsola yaz]
    Y --> Y2{sonuç başarılı mı?}
    Y2 -- Hayır --> Y3[10 sn bekle]
    Y3 --> S
    Y2 -- Evet --> Y4[bekleme süresini konsola yaz]
    Y4 --> S

    X --> X1[login: paper API'den access_token al]
    X1 --> X2{token alındı mı?}
    X2 -- Hayır --> X3[EvalOutcome hata ile döndür]
    X3 --> Y
    X2 -- Evet --> X4[fetch_analysis: detect-ms'den seviye verisini çek]
    X4 --> X5{detect-ms hatası var mı?}
    X5 -- Evet --> X6[EvalOutcome hata ile döndür]
    X6 --> Y
    X5 -- Hayır --> X7[fetch_price_feed: REST üzerinden güncel fiyatı çek]
    X7 --> X8[fiyatı seç: price_override > REST fiyat > current_price]
    X8 --> X9[evaluate: kırılım sinyali üret]

    X9 --> EV1{data hatası var mı?}
    EV1 -- Evet --> EV2[None ve hata mesajı döndür]
    EV1 -- Hayır --> EV3{levels dizisi boş mu?}
    EV3 -- Evet --> EV4[None ve seviye yok döndür]
    EV3 -- Hayır --> EV5[ats, trend ve confluence değerlerini oku]
    EV5 --> EV6{ats > 0 mı?}
    EV6 -- Evet --> EV7[best_level ile en yüksek skorlu SH direncini bul]
    EV7 --> EV8{SH seviyesi var mı?}
    EV8 -- Evet --> EV9{fiyat > SH mi?}
    EV9 -- Evet --> EV10[BUY sinyali üret]
    EV9 -- Hayır --> EV11[None ve direnç kırılmadı döndür]
    EV8 -- Hayır --> EV12[None ve direnç yok döndür]
    EV6 -- Hayır --> EV13{ats < 0 mı?}
    EV13 -- Evet --> EV14[best_level ile en yüksek skorlu SL desteğini bul]
    EV14 --> EV15{SL seviyesi var mı?}
    EV15 -- Evet --> EV16{fiyat < SL mi?}
    EV16 -- Evet --> EV17[SELL sinyali üret]
    EV16 -- Hayır --> EV18[None ve destek kırılmadı döndür]
    EV15 -- Hayır --> EV19[None ve destek yok döndür]
    EV13 -- Hayır --> EV20[None ve nötr trend döndür]
    EV10 --> X10
    EV11 --> X10
    EV12 --> X10
    EV17 --> X10
    EV18 --> X10
    EV19 --> X10
    EV20 --> X10

    X9 --> X10{dry_run modu mu?}
    X10 -- Evet --> X11[EvalOutcome emirsiz döndür]
    X11 --> Y
    X10 -- Hayır --> X12{signal var mı?}
    X12 -- Hayır --> X13[EvalOutcome sinyalsiz döndür]
    X13 --> Y
    X12 -- Evet --> X14[get_positions: açık pozisyonları sorgula]
    X14 --> X15{sembolde açık pozisyon var mı?}
    X15 -- Evet --> X16[EvalOutcome emir açılmadan döndür]
    X16 --> Y
    X15 -- Hayır --> X17[place_order: MARKET emri gönder]
    X17 --> X18[EvalOutcome emir sonucu ile döndür]
    X18 --> Y
