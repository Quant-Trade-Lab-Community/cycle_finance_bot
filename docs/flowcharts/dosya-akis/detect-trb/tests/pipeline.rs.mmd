graph TD
    A([Başlangıç]) --> B[mk_inflow: sentetik inflow üret — fiyat, hacim, tasfiye, bsr]
    B --> C[inflow dizisi oluştur: 10-30 adım]
    C --> D{Test: PhaseSpace kurulum}
    D --> E[PhaseSpace::from_inflows ile grid kur]
    E --> F[divergence_norm hesapla]
    F --> G{norm sonlu ve >= 0 mı?}
    G -- Hayır --> H[expect panic: test başarısız]
    G -- Evet --> I{Test: NSSolver tam boru hattı}

    I --> J[Her inflow için solver.step]
    J --> K[state = solver.state]
    K --> L{steps_completed == adım sayısı ve is_stable mı?}
    L -- Hayır --> H
    L -- Evet --> M{Test: analyze_inflows tam boru hattı}

    M --> N[grid + solver + kavitasyon + kalibrasyon + TWAP + naratif]
    N --> O{burst_signal None veya Some, NaN içermiyor mu?}
    O -- Hayır --> H
    O -- Evet --> P{Test: TWAP eğrisi normalize}

    P --> Q[build_twap_curve: toplam boyut 1.0]
    Q --> R{toplam 1.0 ve dilim sayısı doğru mu?}
    R -- Hayır --> H
    R -- Evet --> S{Test: JSON NaN/Inf kontrolü}

    S --> T[serde_json::to_value + walk ile tüm sayıları dolaş]
    T --> U{NaN veya Inf değer var mı?}
    U -- Evet --> H[test başarısız: panic]
    U -- Hayır --> V{Test: kalibrasyon sınırları}

    V --> W{viskozite 1e-4..1, Cs 0.01..0.3, grid 64x16, inflow_steps doğru mu?}
    W -- Hayır --> H
    W -- Evet --> X[Tüm testler geçti]
    X --> Z([Bitiş])
