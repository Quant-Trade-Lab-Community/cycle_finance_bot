graph TD
    A([Başlangıç]) --> B[calibrate: inflows dizisi al]
    B --> C{inflows boş mu?}
    C -- Evet --> E1[Err: DataStall]
    C -- Hayır --> D[target = target_energy: alış-satış dengesizliği + tasfiye]
    D --> E[cost closure tanımla: nu_eff = nu çarpı 1 + 0.5 çarpı Cs]
    E --> F[nelder_mead: başlangıç noktası 0.1, 0.05]

    F --> G[Simpleks 3 nokta oluştur: x0 ve eksen yönünde NM_LAMBDA ile genişlet]
    G --> H{iterasyon döngüsü}

    H --> I[Her noktanın maliyetini cost ile hesapla]
    I --> J[Noktaları maliyete göre sırala]
    J --> K[iters += 1, spread = en kötü eksi en iyi maliyet]
    K --> L{iters >= 60 veya spread <= tol veya en iyi sonlu değil mi?}
    L -- Evet --> M{en iyi maliyet sonsuz veya NaN mi?}
    M -- Evet --> N1[x0 + maliyet 0 + iters döndür: varsayılana düş]
    M -- Hayır --> N2[En iyi nokta + maliyet + iters döndür]
    L -- Hayır --> O[centroid = en iyi iki noktanın ortalaması]
    O --> P[Reflection: xr = centroid + centroid eksi worst]
    P --> Q{fr ikinci en iyi ile en iyi arasında mı?}
    Q -- Evet --> H[pts2 = xr, fr]
    Q -- Hayır --> R{fr en iyiden küçük mü?}
    R -- Evet --> S[Expansion: xe = centroid + 2 çarpı xr eksi centroid]
    S --> T[pts2 = daha iyi olan xe veya xr]
    T --> H
    R -- Hayır --> U[Contraction: xc = centroid + 0.5 çarpı worst eksi centroid]
    U --> V{fc < worst maliyet mi?}
    V -- Evet --> H[pts2 = xc, fc]
    V -- Hayır --> W[Shrink: noktaları en iyiye doğru 0.5 ile çek]
    W --> H

    N1 --> X[Ok: CalibrationResult — viskozite, Cs, maliyet, iterasyon]
    N2 --> X
    X --> Y[simulate: inflow küçük kısmıyla NSSolver çalıştır]
    Y --> Y1[n = min len, MAX_SIM_STEPS; grid kur]
    Y --> Y2{grid kurulabildi mi?}
    Y2 -- Hayır --> E2[cost sonsuz döner]
    Y2 -- Evet --> Y3[nu_eff = viskozite geçerliyse onu, yoksa grid.viscous]
    Y3 --> Y4[solver.grid.viscous = nu_eff ata]
    Y4 --> Y5{Her inflow için solver.step}
    Y5 --> Y6{adım başarılı mı?}
    Y6 -- Hayır --> E2
    Y6 -- Evet --> Y7{tüm inflow'lar bitti mi?}
    Y7 -- Hayır --> Y5
    Y7 -- Evet --> Y8[KE yoğunluğu = kareler ortalamasının karekökü]
    Y8 --> Y9{KE NaN veya Inf mi?}
    Y9 -- Evet --> E2
    Y9 -- Hayır --> Y10[div = solver.state().divergence_norm]
    Y10 --> Y11[maliyet = KE hatası + 1e-9 çarpı div]
    Y11 --> Z([Bitiş])
