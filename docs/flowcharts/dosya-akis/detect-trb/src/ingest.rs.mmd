graph TD
    A([Başlangıç]) --> B[load_from_sqlite: SQLite bağlantısı aç]
    B --> C{bağlantı açılabildi mi?}
    C -- Hayır --> E1[Err: DbError]
    C -- Evet --> D[trades SELECT sorgusu hazırla]
    D --> E{sorgu hazırlanabildi mi?}
    E -- Hayır --> E1
    E -- Evet --> F[trade tick'lerini çek: fiyat, miktar, zaman]
    F --> G{trades boş mu?}
    G -- Evet --> E2[warn yaz + Err: DataStall]
    G -- Hayır --> H[load_liquidations: tasfiye hacmi haritası]
    H --> I[load_latest_funding: en güncel funding rate]
    I --> J[load_oi_delta: son iki kayıt arası fark]
    J --> K[aggregate_to_inflows]

    K --> L[trades'i zamana göre sırala]
    L --> M{trades boş veya interval_ms == 0 veya zaman aralığı yok mu?}
    M -- Evet --> N1[boş dizi döndür]
    M -- Hayır --> N[n_buckets = zaman aralığı / interval_ms, limit e kırp]
    N --> O{her bucket b için}

    O --> P[bucket_start ve bucket_end hesapla]
    P --> Q{bucket aralığında trade var mı?}
    Q -- Hayır --> O
    Q -- Evet --> R[VWAP = hacim ağırlıklı ortalama fiyat]
    R --> S[liq_vol = bucket aralığındaki tasfiye hacmi toplamı]
    S --> T[InflowData üret: price, volume, buy_sell_ratio 0.5]
    T --> U{tüm bucket'lar işlendi mi?}
    U -- Hayır --> O
    U -- Evet --> V[tarihsel InflowData dizisi döndür]

    V --> W1[drain_ring_buffer: ring buffer aç]
    W1 --> W2{açılabildi mi? catch_unwind}
    W2 -- Hayır --> W3[warn yaz + boş dizi döndür]
    W2 -- Evet --> W4[head = get_head]
    W4 --> W5{head == 0 mı?}
    W5 -- Evet --> W3
    W5 -- Hayır --> W6[sym_bytes = sembolün 16 baytlık gösterimi]
    W6 --> W7{her seq için start_seq..head}

    W7 --> W8{slot okunabiliyor mu?}
    W8 -- Hayır --> W7
    W8 -- Evet --> W9{wire::decode başarılı mı?}
    W9 -- Hayır --> W7
    W9 -- Evet --> W10{sembol eşleşiyor mu?}
    W10 -- Hayır --> W7
    W10 -- Evet --> W11{payload Türü: Trade mi?}
    W11 -- Evet --> W12[Tick'ten InflowData üret: bsr 0.7 veya 0.3]
    W11 -- Hayır --> W13{Liquidation mi?}
    W13 -- Evet --> W14[Tasfiye InflowData üret: liquidation_volume = fiyat çarpı miktar]
    W13 -- Hayır --> W15{FundingRate mi?}
    W15 -- Evet --> W16[Funding InflowData üret: funding_rate al]
    W15 -- Hayır --> W17{OpenInterest mi?}
    W17 -- Evet --> W18[OI InflowData üret: oi_delta al]
    W17 -- Hayır --> W7
    W12 --> W19{inflows.len() >= max_ticks mi?}
    W14 --> W19
    W16 --> W19
    W18 --> W19
    W19 -- Evet --> W20[Canlı InflowData dizisi döndür]
    W19 -- Hayır --> W7
    W20 --> M1[merge_sources: canlı veriyi tarihsel veriyle birleştir]
    M1 --> M2[sqlite_max_ts = tarihsel verinin en son zaman damgası]
    M2 --> M3[ring tick'lerini filtrele: daha yeni ve price > 0]
    M3 --> M4[sqlite_inflows a ekle ve zamana göre sırala]
    M4 --> Z([Bitiş])
