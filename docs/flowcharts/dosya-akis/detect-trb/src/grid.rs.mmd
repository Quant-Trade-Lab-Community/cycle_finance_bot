graph TD
    A([Başlangıç]) --> B[PhaseSpace::from_inflows: inflows dizisi al]
    B --> C{inflows boş mu?}
    C -- Evet --> E1[Err: DataStall]
    C -- Hayır --> D[prices = fiyatı sıfırdan büyük tick'ler]
    D --> E{prices boş mu?}
    E -- Evet --> E1
    E -- Hayır --> F[p_min ve p_max hesapla]
    F --> G{p_min <= 0 veya p_max <= p_min?}
    G -- Evet --> E2[Err: InvalidGridDimension]
    G -- Hayır --> H[log_p_min, log_p_max, dx, dy, nz hesapla]
    H --> I[density, vel_x, vel_y, pressure, history sıfır dizileri]
    I --> J[total_vol = toplam hacim, alt sınır 1]
    J --> K{her inflow için t ve inflow}

    K --> L{inflow.price <= 0?}
    L -- Evet --> K
    L -- Hayır --> M[ix = log-fiyat bin indeksi, NX-1 e kırp]
    M --> N[iy = derinlik indeksi, NY-1 e kırp]
    N --> O[density += volume / total_vol]
    O --> P[vel_x += buy_sell_ratio eksi 0.5 çarpı 2]
    P --> Q[vel_y -= liquidation_volume / total_vol]
    Q --> R[pressure += funding_rate çarpı 1000 + oi_delta çarpı 0.001]
    R --> S[history ix, iy, t = volume / total_vol]
    S --> T{tüm inflow'lar işlendi mi?}
    T -- Hayır --> K
    T -- Evet --> U{density NaN veya Inf içeriyor mu?}
    U -- Evet --> E3[Err: DivergenceExplosion]
    U -- Hayır --> V[PhaseSpace döndür: viscous 0.1]

    V --> D1[divergence: div = sıfır dizi NX çarpı NY]
    D1 --> D2[Her y dilimi için x-yönü SIMD merkezi fark]
    D2 --> D3[Kalan iç noktalar skaler, sınırlar tek taraflı fark]
    D3 --> D4[y-yönü skaler merkezi fark + sınır koşulları]
    D4 --> D5{div NaN veya Inf içeriyor mu?}
    D5 -- Evet --> E4[Err: DivergenceExplosion]
    D5 -- Hayır --> D6[div dizisini döndür]
    D6 --> D7[divergence_norm: kareler toplamının karekökü]
    D7 --> D8[reset: tüm alanları sıfırla, viscous = 0.1]
    D8 --> Z([Bitiş])
