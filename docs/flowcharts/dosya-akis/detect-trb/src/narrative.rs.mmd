graph TD
    A([Başlangıç]) --> B[narrate: state, calibration, burst, symbol al]
    B --> C[phase = phase_label]
    C --> C1{burst var mı?}
    C1 -- Evet --> C2[Kavitasyon Dalgası]
    C1 -- Hayır --> C3{state.is_stable false mu?}
    C3 -- Evet --> C4[Iraksama / Dengesiz]
    C3 -- Hayır --> C5{mean_density > 2.0 mı?}
    C5 -- Evet --> C6[Yoğunlaşma]
    C5 -- Hayır --> C7{mean_density < 0.05 mi?}
    C7 -- Evet --> C8[Seyreltme]
    C7 -- Hayır --> C9[Kararlı Akış]

    B --> D[flow = flow_direction]
    D --> D1{max_velocity > 1e-9 mu?}
    D1 -- Hayır --> D5[Yatay Durağan]
    D1 -- Evet --> D2{mean_pressure > 0.0 mı?}
    D2 -- Evet --> D3[Yukarı Akış]
    D2 -- Hayır --> D4[Aşağı Akış]

    B --> E[turb = turbulence_level]
    E --> E1{max_velocity sonlu mu?}
    E1 -- Hayır --> E2[Belirsiz]
    E1 -- Evet --> E3{max_velocity > 1.0 mı?}
    E3 -- Evet --> E4[Yüksek]
    E3 -- Hayır --> E5{max_velocity > 0.1 mi?}
    E5 -- Evet --> E6[Orta]
    E5 -- Hayır --> E7[Düşük]

    C2 --> F
    C4 --> F
    C6 --> F
    C8 --> F
    C9 --> F[summary metni oluştur: faz + akış + basınç + viskozite]
    D3 --> F
    D4 --> F
    D5 --> F
    E2 --> F
    E4 --> F
    E6 --> F
    E7 --> F
    F --> G{burst var mı?}
    G -- Evet --> G1[summary ya kavitasyon bilgisi ekle]
    G -- Hayır --> G2[summary ya sinyal yok notu ekle]
    G1 --> H{risk_warning seçimi}
    G2 --> H
    H --> H1{burst var mı?}
    H1 -- Evet --> H2[Tasfiye şok dalgası uyarısı — likidite riski yüksek]
    H1 -- Hayır --> H3{state.is_stable false mu?}
    H3 -- Evet --> H4[Kararsız çözücü uyarısı — sinyal güvenilirliği düşük]
    H3 -- Hayır --> H5[Standart risk notu — yatırım tavsiyesi değildir]
    H2 --> I[NarrativeOutput döndür]
    H4 --> I
    H5 --> I
    I --> J[audit_meta: zaman, grid NX çarpı NY, veri kaynağı, sürüm]
    J --> Z([Bitiş])
