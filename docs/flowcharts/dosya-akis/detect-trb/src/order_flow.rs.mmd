graph TD
    A([Başlangıç]) --> B[build_twap_curve: basınç gradyanı, yön al]
    B --> C{gradyan sonlu mu?}
    C -- Hayır --> E1[Err: DivergenceExplosion]
    C -- Evet --> D[n = dilim sayısı, varsayılan 8]
    D --> E[r = risk_aversion, 0-1 e kırp]
    E --> F[ağırlıklar = r üzeri i: geometrik azalma]
    F --> G{toplam sıfır veya sonlu değil mi?}
    G -- Evet --> E1
    G -- Hayır --> H[g = gradyan mutlak değeri, üst sınır 10]
    H --> I[dir = yön işareti: pozitif 1, negatif eksi 1]
    I --> J{Her dilim için}

    J --> K[size = w / toplam, 0-1 e kırp]
    K --> L[price_offset = dir çarpı g çarpı ilerleme oranı çarpı PRICE_IMPACT]
    L --> M[OrderSlice ekle: size, price_offset, index]
    M --> N{tüm dilimler bitti mi?}
    N -- Hayır --> J
    N -- Evet --> O{toplam 1.0 dan sapma var mı?}
    O -- Evet --> P[Son dilimi 1.0-a tamamla]
    O -- Hayır --> Q[TWAP eğrisi döndür]
    P --> Q

    Q --> R[net_direction: burst yönü veya gradyan işareti]
    R --> R1{direction_from_burst: burst var mı?}
    R1 -- Evet --> R2{LONG mi?}
    R2 -- Evet --> R3[1.0 yukarı]
    R2 -- Hayır --> R4[eksi 1.0 aşağı]
    R1 -- Hayır --> R5{gradyan > 1e-12 mi?}
    R5 -- Evet --> R6[1.0 yukarı]
    R5 -- Hayır --> R7{gradyan < eksi 1e-12 mi?}
    R7 -- Evet --> R8[eksi 1.0 aşağı]
    R7 -- Hayır --> R9[0.0 yatay]
    R3 --> Z([Bitiş])
    R4 --> Z
    R6 --> Z
    R8 --> Z
    R9 --> Z
