graph TD
    A([Başlangıç: AuditRecord::decision&#40;bar, score, event_label, phase, bias, signal, tick_size&#41;]) --> B[timestamp = bar.timestamp]
    B --> C[close = bar.close.0 * tick_size]
    C --> D[spread_ticks = bar.spread_ticks&#40;&#41;]
    D --> E[volume = bar.volume.0]
    E --> F[score = score 4 basamağa yuvarla]
    F --> G[event = event_label]
    G --> H[acc = phase.accumulation_weight yuvarla]
    H --> I[dist = phase.distribution_weight yuvarla]
    I --> J[trend_strength = phase.trend_strength yuvarla]
    J --> K[bias = bias.label&#40;&#41;]
    K --> L{signal var mı?}
    L -- Evet --> M[signal = signal.label&#40;&#41;]
    L -- Hayır --> N[signal = null]
    M --> O[json! oluştur]
    N --> O
    O --> Z([Bitiş: serde_json::Value])
