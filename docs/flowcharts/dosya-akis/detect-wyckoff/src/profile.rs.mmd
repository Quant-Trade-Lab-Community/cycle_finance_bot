graph TD
    A([Başlangıç: IncrementalVolumeProfile]) --> B[buckets = BTreeMap, total_volume = 0, decay_factor = 0.999]

    subgraph update
        C[update&#40;bar&#41;] --> D[current_time = bar.timestamp]
        D --> E[mid = bar.mid_tick&#40;&#41;]
        E --> F{bucket var mı?}
        F -- Hayır --> G[or_insert&#40;volume: 0, last_update: bar.timestamp&#41;]
        F -- Evet --> H[age = bar.timestamp - last_update]
        G --> I[decayed = volume * decay_factor^&#40;age / 60000&#41;]
        H --> I
        I --> J[entry.volume = decayed + bar.volume, last_update = bar.timestamp]
        J --> K[total_volume += bar.volume]
        K --> L{buckets.len > MAX_BUCKETS&#40;4096&#41;?}
        L -- Evet --> M[ilk yarı bucket'ları sil]
        L -- Hayır --> N[son]
        M --> N
    end

    subgraph live_volume
        O[live_volume&#40;key&#41;] --> P{bucket var mı?}
        P -- Hayır --> Q[0.0 döndür]
        P -- Evet --> R[age = current_time - last_update]
        R --> S[volume * decay_factor^&#40;age / 60000&#41; döndür]
    end

    subgraph poc
        T[poc&#40;&#41;] --> U[en yüksek hacimli bucket'ı bul]
        U --> V[Tick döndür]
    end

    subgraph snapshot
        W[snapshot&#40;tick_size, n&#41;] --> X[bucket'ları hacme göre azalan sırala]
        X --> Y[ilk n bucket'ı al]
        Y --> Z[VolumeProfileSnapshot oluştur]
    end
