graph TD
    A([Başlangıç: analyze&#40;klines, cfg&#41;]) --> B{klines.is_empty()?}
    B -- Evet --> C[return Err&#40;"Veri yok"&#41;]
    B -- Hayır --> D[asset = default_asset, bars = kline&#95;ler Bar'a çevir + spread >= min_move filtrele]

    D --> E{bars.is_empty()?}
    E -- Evet --> F[return Err&#40;"min_move filtrelemesinden sonra bar kalmadı"&#41;]
    E -- Hayır --> G[current_price = son bar kapanışı * tick_size]
    G --> H[scorer = ContextualScorer::build&#40;bars&#41;, range_low, avg_volume hesapla]
    H --> I[machine = WyckoffStateMachine, profile = with_decay&#40;0.999&#41;, risk = AdaptiveRiskEngine]

    I --> J[signals / events / audit / last_action başlat]
    J --> K{döngü: her bar için}
    K --> L[profile.update&#40;bar&#41;]
    L --> M[sig = machine.ingest&#40;bar, scorer&#41;]

    M --> N{sig var mı?}
    N -- Evet --> O[signals.push&#40;side, entry, confidence&#41;]
    O --> P{signals.len > 20?}
    P -- Evet --> Q[en eski sinyali sil]
    P -- Hayır --> R
    N -- Hayır --> R[scored_events'i events haritasına işle]

    R --> S[last_action = risk.evaluate&#40;bar, machine.state&#41;]
    S --> T[audit.push&#40;decision&#41;]
    T --> U{audit.len > 16?}
    U -- Evet --> V[en eski audit kaydını sil]
    U -- Hayır --> W
    V --> W{bar döngüsü bitti mi?}
    W -- Hayır --> K
    W -- Evet --> X[machine.state.trend_strength = scorer.trend_angle]

    X --> Y[structure = structural_position]
    Y --> Z[probs = probability_forecast]
    Z --> AA[bias = suggested_bias]
    AA --> AB[audit.push&#40;FINAL kararı&#41;]
    AB --> AC[phases = ewma_phase_weights&#40;bars, window&#41;]
    AC --> AD[wyckoff_events sırala, last_event_label bul]
    AD --> AE[risk_record = risk.record&#40;last_action, tick_size&#41;]
    AE --> AF[narrative oluştur]

    AF --> AG{son sinyal var mı?}
    AG -- Evet --> AH[execution_plan = broker.execute + plan]
    AG -- Hayır --> AI
    AH --> AI[Ok&#40;Insight&#41; oluştur]
    AI --> Z2([Bitiş])

    subgraph structural_position
        B1[StructuralPosition hesapla] --> B2{POC mesafesi, hacim trendi, spread durumu, fiyat bandı}
        B2 --> B3[invalidation_upper = rng_high * 1.015, invalidation_lower = rng_low * 0.985]
    end

    subgraph probability_forecast
        P1[ProbabilityForecast hesapla] --> P2[breakout_upper = 0.50 + poc_factor * 0.40]
        P2 --> P3{spread "Daralıyor" mu?}
        P3 -- Evet --> P4[breakout_upper += 0.10]
        P3 -- Hayır --> P5
        P4 --> P5[breakdown_lower = 0.10 + &#40;1-poc_factor&#41; * 0.30]
        P5 --> P6[range_continuation = 1 - breakout - breakdown]
        P6 --> P7[volatility_risk_pct, fake_break_risk, momentum_risk hesapla]
        P7 --> P8[size_factor = &#40;1 - vol_risk&#41; * &#40;1 - fake_break&#41; * &#40;1 - momentum&#41;]
    end

    subgraph suggested_bias
        S1[probs.breakout_upper > 0.65 ve fake_break < 0.35?] -- Evet --> S2[Bias::Bullish]
        S1 -- Hayır --> S3{probs.breakdown_lower > 0.55 ve fake_break < 0.30?}
        S3 -- Evet --> S4[Bias::Bearish]
        S3 -- Hayır --> S5{accumulation_weight > 0.6 ve trend_angle > 0?}
        S5 -- Evet --> S6[Bias::Bullish]
        S5 -- Hayır --> S7{distribution_weight > 0.6 ve trend_angle < 0?}
        S7 -- Evet --> S8[Bias::Bearish]
        S7 -- Hayır --> S9[Bias::Neutral]
    end

    subgraph ewma_phase_weights
        E1[her bar için instant_scores hesapla] --> E2[EWMA: skor = skor * 0.85 + anlık * 0.15]
        E2 --> E3{window.len < 10?}
        E3 -- Evet --> E4[neutral skorlar &#40;0.25&#41;]
        E3 -- Hayır --> E5{ratio < 0.3 ve hacim yüksek?}
        E5 -- Evet --> E6[acc = 0.8]
        E5 -- Hayır --> E7{ratio > 0.6, hacim yüksek, yeşil mum?}
        E7 -- Evet --> E8[markup = 0.75]
        E7 -- Hayır --> E9{ratio > 0.7 ve hacim düşük?}
        E9 -- Evet --> E10[dist = 0.7]
        E9 -- Hayır --> E11{ratio < 0.4 ve kırmızı mum?}
        E11 -- Evet --> E12[markdown = 0.7]
        E11 -- Hayır --> E13[kararsız skorlar &#40;acc=0.4, diğerleri=0.2&#41;]
        E6 --> E14[phase_label seçimi]
        E8 --> E14
        E10 --> E14
        E12 --> E14
        E13 --> E14
    end
