graph TD
    A([Başlangıç: ContextualScorer]) --> B[build&#40;bars&#41;]

    subgraph build
        C[closes = tüm bar kapanışları] --> D[ema = EMA&#40;closes, 50&#41;]
        D --> E{ema.len >= 2 ve prev != 0?}
        E -- Evet --> F[trend_angle = &#40;last - prev&#41; / abs&#40;prev&#41; clamp -1..1]
        E -- Hayır --> G[trend_angle = 0.0]
        F --> H[atr = ATR&#40;bars, 14&#41;]
        G --> H
        H --> I[atr_percent = &#40;atr / last_close&#41;.min&#40;1.0&#41;]
        I --> J[range_high = max&#40;high&#41;, range_low = min&#40;low&#41;]
        J --> K[ContextualScorer oluştur]
    end

    subgraph evaluate
        L[evaluate&#40;event&#41;] --> M[raw_score = event.strength clamp 0..1]
        M --> N[proximity = fiyatın range içindeki konumu 0..1]
        N --> O{event.raw =?}
        O -- Spring --> P{trend_angle < -0.3?}
        P -- Evet --> Q[context_modifier = 0.2]
        P -- Hayır --> R{trend_angle > 0.3?}
        R -- Evet --> S[context_modifier = 1.4]
        R -- Hayır --> T[context_modifier = 1.0]
        O -- SignOfStrength --> U{proximity > 0.8?}
        U -- Evet --> V[context_modifier = 1.5]
        U -- Hayır --> W[context_modifier = 0.8]
        O -- UpThrust --> X{trend_angle > 0.3?}
        X -- Evet --> Y[context_modifier = 0.3]
        X -- Hayır --> Z[context_modifier = 1.2]
        O -- SellingClimax --> AA{proximity < 0.2?}
        AA -- Evet --> AB[context_modifier = 1.3]
        AA -- Hayır --> AC[context_modifier = 0.9]
        Q --> AD[atr_mod = 1.0 - atr_percent.min&#40;0.5&#41;]
        S --> AD
        T --> AD
        V --> AD
        W --> AD
        Y --> AD
        Z --> AD
        AB --> AD
        AC --> AD
        AD --> AE[raw = raw_score * context_modifier * atr_mod]
        AE --> AF[sigmoid: 1 / &#40;1 + exp&#40;-8 * &#40;raw - 0.5&#41;&#41;&#41;]
        AF --> Z2([Bitiş: skor 0..1])
    end
