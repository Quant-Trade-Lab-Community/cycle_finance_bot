graph TD
    A([Başlangıç: WyckoffStateMachine]) --> B[new&#40;&#41;: state varsayılan, stats sıfır, history = 40 kapasiteli]

    subgraph observe
        C[observe&#40;bar&#41;] --> D[history.push_back&#40;bar&#41;]
        D --> E{history.len > 40?}
        E -- Evet --> F[en eski barı pop_front]
        E -- Hayır --> G[son]
    end

    subgraph detect_all
        H[detect_all&#40;bar&#41;] --> I{window_extremes var mı?}
        I -- Hayır --> J[boş events döndür]
        I -- Evet --> K{history.back var mı?}
        K -- Hayır --> L[boş events döndür]
        K -- Evet --> M[avg_vol = pencere ortalama hacmi]
        M --> N{low <= rng_low * 1.002 ve close > prev_close?}
        N -- Evet --> O[Spring ekle: strength = 0.5 + &#40;volume / avg_vol&#41; clamp]
        N -- Hayır --> P{close > prev.high ve volume > avg_vol * 1.5?}
        P -- Evet --> Q[SOS ekle]
        P -- Hayır --> R{high >= rng_high * 0.98 ve close < open?}
        R -- Evet --> S[UT ekle]
        R -- Hayır --> T{low <= rng_low * 1.001 ve volume > avg_vol * 2.5 ve close < open?}
        T -- Evet --> U[SC ekle]
        T -- Hayır --> V[events döndür]
        O --> V
        Q --> V
        S --> V
        U --> V
    end

    subgraph update_weights
        W[update_weights&#40;event&#41;] --> X{Spring veya SOS?}
        X -- Evet --> Y[accumulation_weight += 0.1, distribution_weight -= 0.05]
        X -- Hayır --> Z[UpThrust veya SC: distribution_weight += 0.1, accumulation_weight -= 0.05]
        Y --> AA[softmax normalize: ağırlıklar toplama bölünür]
        Z --> AA
    end

    subgraph ingest
        AB[ingest&#40;bar, scorer&#41;] --> AC[events = detect_all&#40;bar&#41;]
        AC --> AD{events boş mu?}
        AD -- Evet --> AE[observe&#40;bar&#41;, None döndür]
        AD -- Hayır --> AF[her event için scorer.evaluate, stats_inc]
        AF --> AG[scored_events = en yeni 8'i al]
        AG --> AH[best = en yüksek skorlu event]
        AH --> AI{score > 0.82?}
        AI -- Hayır --> AJ[observe&#40;bar&#41;, None döndür]
        AI -- Evet --> AK[update_weights&#40;event.raw&#41;]
        AK --> AL{Spring ve trend_angle < -0.3?}
        AL -- Evet --> AM[fake_springs += 1]
        AL -- Hayır --> AN{SOS ve accumulation_weight > 0.75?}
        AM --> AN
        AN -- Evet --> AO[long_signals += 1, observe, Signal::Long döndür]
        AN -- Hayır --> AP{UT ve distribution_weight > 0.75?}
        AP -- Evet --> AQ[short_signals += 1, observe, Signal::Short döndür]
        AP -- Hayır --> AR[observe&#40;bar&#41;, None döndür]
    end
