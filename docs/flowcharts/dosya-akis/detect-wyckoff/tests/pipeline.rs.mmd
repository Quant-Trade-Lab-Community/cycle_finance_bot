graph TD
    A([Başlangıç: pipeline testleri]) --> B[segments&#40;&#41;: deterministik rng ile BTC benzeri veri üret]
    B --> C[Faz1: düşüş 100 bar, her 9. barda sahte Spring]
    C --> D[Faz2: birikim 120 bar, her 7. barda Spring]
    D --> E[Faz3: markup 140 bar, her 5. barda hacim patlaması]

    subgraph fake_spring_filter_under_5_percent
        F[down segmenti ile analyst::analyze] --> G{analiz başarılı?}
        G -- Hayır --> H[panic: analiz başarısız]
        G -- Evet --> I[total = springs, long = long_signals, fake = fake_springs]
        I --> J{total > 0?}
        J -- Hayır --> K[panic: Spring tespit edilmeli]
        J -- Evet --> L{long / total < 0.05?}
        L -- Hayır --> M[panic: sahte Spring oranı yüksek]
        L -- Evet --> N{fake <= 1?}
        N -- Hayır --> O[panic: fake_springs büyük]
        N -- Evet --> Z1([Bitiş])
    end

    subgraph real_accumulation_emits_signals
        P[down + acc + up birleştir] --> Q[analyst::analyze]
        Q --> R{springs > 0 ve long_signals > 0 ve sos > 0?}
        R -- Evet --> Z2([Bitiş])
        R -- Hayır --> S[panic]
    end

    subgraph markup_segment_pumps_sos
        T[up segmenti ile analyze] --> U{sos > 0?}
        U -- Evet --> Z3([Bitiş])
        U -- Hayır --> V[panic]
    end

    subgraph insight_serializes_to_json
        W[full veri ile analyze] --> X[serde_json::to_value]
        X --> Y{phase_distribution, probability_forecast, audit_trail, calibration_version var mı?}
        Y -- Evet --> Z4([Bitiş])
        Y -- Hayır --> Z5[panic]
    end

    subgraph softmax_normalization_sums_to_one
        A2[machine.update_weights: SOS, SOS, UT] --> B2[sum = acc + dist]
        B2 --> C2{abs&#40;sum - 1&#41; < 1e-9?}
        C2 -- Evet --> Z6([Bitiş])
        C2 -- Hayır --> D2[panic]
    end

    subgraph volume_profile_lazy_decay_and_poc
        A3[profile = with_decay&#40;0.999&#41;] --> B3[1 dk arayla 2 bar ekle]
        B3 --> C3{v1 > 198?}
        C3 -- Hayır --> D3[panic: decay agresif]
        C3 -- Evet --> E3[10 dk sonra bar ekle]
        E3 --> F3{v2 < 300?}
        F3 -- Hayır --> G3[panic: lazy decay çalışmıyor]
        F3 -- Evet --> H3{poc == 50_000?}
        H3 -- Hayır --> I3[panic]
        H3 -- Evet --> Z7([Bitiş])
    end

    subgraph analyzer_rejects_empty_input
        A4[analyst::analyze&#40;&[], cfg&#41;] --> B4{sonuç err mi?}
        B4 -- Evet --> Z8([Bitiş])
        B4 -- Hayır --> C4[panic: boş veri hata vermeli]
    end
