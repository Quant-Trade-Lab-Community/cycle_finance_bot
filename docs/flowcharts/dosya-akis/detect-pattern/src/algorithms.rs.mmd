graph TD
    A([Başlangıç: scan_patterns çağrılır]) --> B[detections = boş vektör, n = kline sayısı]
    B --> C{n < 5?}

    C -- Evet --> Z([Bitiş: boş liste döner])
    C -- Hayır --> D[sabitler tanımlanır: epsilon, 2.5, 0.5, 0.3, 0.2, 0.1, 0.95, 0.0001]

    D --> E[for i in 2..n: k1, k2, k3 mumları alınır]
    E --> F[k3 için gövde, üst/alt iğne, toplam boyut hesaplanır]
    F --> G[k2 için gövde ve renk bilgisi hesaplanır]

    G --> H{1. Pin Bar: alt iğne > 2.5*gövde ve üst iğne < 0.5*gövde?}
    H -- Evet --> H1[Hammer kaydı eklenir]
    H -- Hayır --> H2{üst iğne > 2.5*gövde ve alt iğne < 0.5*gövde?}
    H1 --> I
    H2 -- Evet --> H3[Shooting Star kaydı eklenir]
    H2 -- Hayır --> I

    I --> J{2. Engulfing: k3 yeşil, k2 kırmızı, gövde yutmuş?}
    J -- Evet --> J1[Bullish Engulfing eklenir]
    J -- Hayır --> J2{k3 kırmızı, k2 yeşil, gövde yutmuş?}
    J1 --> K
    J2 -- Evet --> J3[Bearish Engulfing eklenir]
    J2 -- Hayır --> K

    K --> L{3. Doji: gövde/total < 0.1 ve her iki iğne > gövde?}
    L -- Evet --> L1[Doji kaydı eklenir]
    L1 --> M
    L -- Hayır --> M

    M --> N{4. Inside Bar: k3.high < k2.high ve k3.low > k2.low?}
    N -- Evet --> N1[Inside Bar kaydı eklenir]
    N1 --> O
    N -- Hayır --> O

    O --> P{5. Marubozu: gövde/total > 0.95?}
    P -- Evet --> P1[Marubozu eklenir: renge göre BULLISH/BEARISH]
    P1 --> Q
    P -- Hayır --> Q

    Q --> R{6. Morning/Evening Star: k1,k2,k3 koşulları?}
    R -- Morning Star --> R1[Morning Star eklenir]
    R -- Evening Star --> R2[Evening Star eklenir]
    R -- Koşul yok --> S
    R1 --> S
    R2 --> S

    S --> T{7. Tweezer: diff_high/diff_low < 0.0001?}
    T -- Tweezer Tops --> T1[Tweezer Tops eklenir]
    T -- Tweezer Bottoms --> T2[Tweezer Bottoms eklenir]
    T -- Koşul yok --> U
    T1 --> U
    T2 --> U

    U --> V{10. Dark Cloud/Piercing: k3 açılış-kapanış koşulları?}
    V -- Dark Cloud Cover --> V1[Dark Cloud Cover eklenir]
    V -- Piercing Line --> V2[Piercing Line eklenir]
    V -- Koşul yok --> W
    V1 --> W
    V2 --> W

    W --> X{11. Spinning Top: gövde oranı 0.1-0.3 ve iğneler > gövde?}
    X -- Evet --> X1[Spinning Top eklenir]
    X1 --> Y
    X -- Hayır --> Y

    Y --> Y1{12. Abandoned Baby: k2 doji ve gap koşulları?}
    Y1 -- Bearish --> Y2[Bearish Abandoned Baby eklenir]
    Y1 -- Bullish --> Y3[Bullish Abandoned Baby eklenir]
    Y1 -- Koşul yok --> E1
    Y2 --> E1
    Y3 --> E1

    E1 --> E2{i'de döngü bitti mi?}
    E2 -- Hayır --> E
    E2 -- Evet --> AA

    AA --> AB[for i in 2..n: 3 White Soldiers / 3 Black Crows]
    AB --> AC{3 mum da aynı renkte ve gövde/iğne koşulları?}
    AC -- 3 yeşil --> AC1[3 White Soldiers eklenir]
    AC -- 3 kırmızı --> AC2[3 Black Crows eklenir]
    AC -- Koşul yok --> AD
    AC1 --> AD
    AC2 --> AD

    AD --> AD1{ikinci döngü bitti mi?}
    AD1 -- Hayır --> AB
    AD1 -- Evet --> AE

    AE --> AF[for i in 5..n: Master Candle taraması]
    AF --> AG[master = klines[i-5], is_master kontrolü başlar]
    AG --> AH{son 5 mum master.high veya master.low dışına çıkıyor mu?}
    AH -- Evet --> AI[is_master = false, döngü kırılır]
    AH -- Hayır --> AJ
    AI --> AJ
    AJ --> AK{is_master true?}
    AK -- Evet --> AK1[Master Candle kaydı eklenir]
    AK1 --> AL
    AK -- Hayır --> AL

    AL --> AM{üçüncü döngü bitti mi?}
    AM -- Hayır --> AF
    AM -- Evet --> AN

    AN --> AO[detections index'e göre sıralanır]
    AO --> Z([Bitiş: tespit edilen formasyonlar döner])
